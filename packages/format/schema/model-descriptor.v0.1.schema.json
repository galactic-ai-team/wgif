{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/galactic-ai-team/wgif/blob/main/packages/format/schema/model-descriptor.v0.1.schema.json",
  "title": "WGIF embedded model descriptor v0.1 (RC review)",
  "description": "One entry of manifest.models[]. Cross-field runtime/fallback rules are enforced by validateWorld(). Model bytes are data only; no executable script payloads.",
  "type": "object",
  "required": [
    "id",
    "path",
    "runtime"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^models/(?!(?:\\.{1,2}|__proto__)(?:/|$))(?!.*\\/(?:\\.{1,2}|__proto__)(?:/|$))(?!.*[\\\\\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
    },
    "runtime": {
      "enum": [
        "rules",
        "onnx"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "shape": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "dtype": {
            "enum": [
              "float32",
              "int32",
              "int64",
              "bool"
            ]
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "shape": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "dtype": {
            "enum": [
              "float32",
              "int32",
              "int64",
              "bool"
            ]
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "tickHz": {
      "type": "number",
      "minimum": 1,
      "maximum": 60
    },
    "deterministic": {
      "type": "boolean"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "sizeBytesMax": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "license": {
      "type": "string",
      "maxLength": 200
    },
    "fallback": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    }
  }
}
