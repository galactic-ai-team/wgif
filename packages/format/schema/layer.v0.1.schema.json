{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/galactic-ai-team/wgif/blob/main/packages/format/schema/layer.v0.1.schema.json",
  "title": "WGIF v0.1 declarative overlay layer",
  "type": "object", "additionalProperties": false,
  "properties": {
    "version": { "enum": ["0.1", "0.1-draft"] },
    "add": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/definitions/add" } },
    "move": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/definitions/move" } },
    "remove": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_:.\\-]+$" },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "move": { "type": "object", "required": ["id", "position"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/definitions/id" }, "position": { "$ref": "#/definitions/vec3" }, "rotation": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } }, "scale": { "$ref": "#/definitions/vec3" } }
    },
    "add": { "type": "object", "required": ["id", "primitive", "position"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/definitions/id" }, "primitive": { "enum": ["box", "sphere", "cylinder"] }, "position": { "$ref": "#/definitions/vec3" }, "size": { "$ref": "#/definitions/vec3" }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
    }
  }
}
