{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/galactic-ai-team/wgif/blob/main/packages/format/schema/manifest.v0.1.schema.json",
  "title": "WGIF manifest v0.1 (draft)",
  "description": "Root manifest.json of a .wgif container. See docs/SPEC-v0.1-draft.md.",
  "type": "object",
  "required": ["wgif", "id", "title", "creator", "created", "mode", "entry", "files"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "wgif": {
      "description": "Format version as MAJOR.MINOR. Readers MUST reject unknown MAJOR versions.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "id": {
      "description": "Stable world identifier. Kept across edits; a fork gets a new id and records its parent.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "creator": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "maxLength": 2048 },
        "publicKey": {
          "description": "Creator ed25519 public key, 32 bytes, lowercase hex.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "created": { "$ref": "#/definitions/timestamp" },
    "modified": { "$ref": "#/definitions/timestamp" },
    "license": { "type": "string", "maxLength": 200 },
    "mode": {
      "description": "Creator-declared edit policy, honoured by compliant players. Not DRM.",
      "enum": ["locked", "editable", "layered"]
    },
    "entry": {
      "type": "object",
      "required": ["scene", "preview"],
      "additionalProperties": false,
      "properties": {
        "scene": { "$ref": "#/definitions/path" },
        "preview": { "$ref": "#/definitions/path" },
        "interactions": { "$ref": "#/definitions/path" },
        "state": { "$ref": "#/definitions/path" }
      }
    },
    "spawn": {
      "type": "object",
      "required": ["position"],
      "additionalProperties": false,
      "properties": {
        "position": { "$ref": "#/definitions/vec3" },
        "lookAt": { "$ref": "#/definitions/vec3" }
      }
    },
    "units": { "enum": ["meters"] },
    "requires": {
      "description": "Capabilities a player must support to open the world fully.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" }
    },
    "files": {
      "description": "Every payload file in the container except manifest.json itself.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "#/definitions/path" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string", "maxLength": 200 },
          "role": {
            "enum": ["scene", "preview", "interactions", "state", "model", "asset", "layer", "other"]
          }
        }
      }
    },
    "models": {
      "description": "Optional embedded AI models. Packaging convention owned by the Embedded AI lane.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "runtime"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/definitions/path" },
          "runtime": { "enum": ["rules", "onnx"] },
          "purpose": { "type": "string" }
        }
      }
    },
    "layers": {
      "description": "Ordered user layers applied on top of the base world (mode = layered).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "author"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/definitions/path" },
          "author": { "type": "string", "minLength": 1 },
          "created": { "$ref": "#/definitions/timestamp" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent": {
          "type": "object",
          "required": ["id", "signingHash"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "signingHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "generator": { "type": "string", "maxLength": 200 },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "at"],
            "additionalProperties": false,
            "properties": {
              "action": { "type": "string" },
              "at": { "$ref": "#/definitions/timestamp" },
              "by": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["alg", "publicKey", "value"],
      "additionalProperties": false,
      "properties": {
        "alg": { "const": "ed25519" },
        "publicKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    },
    "extensions": {
      "description": "Namespaced extension data (e.g. \"x-dee-size\"). Unknown extensions MUST be preserved and MAY be ignored.",
      "type": "object",
      "propertyNames": { "pattern": "^x-[a-z0-9-]+$" }
    }
  },
  "definitions": {
    "path": {
      "description": "Relative POSIX path inside the container. No leading slash, no '..', no backslashes.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    }
  }
}
