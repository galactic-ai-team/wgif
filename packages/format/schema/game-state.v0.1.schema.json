{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/galactic-ai-team/wgif/blob/main/packages/format/schema/game-state.v0.1.schema.json",
  "title": "WGIF v0.1 initial game state",
  "type": "object", "additionalProperties": false,
  "properties": {
    "version": { "enum": ["0.1", "0.1-draft"] },
    "score": { "type": "integer", "minimum": 0 },
    "minigames": {
      "type": "object", "maxProperties": 100, "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": { "type": "object", "additionalProperties": false,
        "properties": { "highScore": { "type": "integer", "minimum": 0 }, "plays": { "type": "integer", "minimum": 0 }, "score": { "type": "integer", "minimum": 0 } }
      }
    },
    "objects": {
      "type": "object", "maxProperties": 10000, "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": { "type": "object", "additionalProperties": false,
        "properties": {
          "position": { "$ref": "#/definitions/vec3" }, "rotation": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
          "scale": { "$ref": "#/definitions/vec3" }, "enabled": { "type": "boolean" }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_:.\\-]+$" },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
  }
}
