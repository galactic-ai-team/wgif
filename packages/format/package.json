{
  "name": "@wgif/format",
  "version": "0.1.0-draft.0",
  "description": "Reference reader/writer/validator for WGIF v0.1 release candidate.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": { "wgif": "./bin/wgif.js" },
  "exports": {
    ".": "./src/index.ts",
    "./schema/manifest.v0.1.schema.json": "./schema/manifest.v0.1.schema.json",
    "./schema/interactions.v0.1.schema.json": "./schema/interactions.v0.1.schema.json",
    "./schema/game-state.v0.1.schema.json": "./schema/game-state.v0.1.schema.json",
    "./schema/layer.v0.1.schema.json": "./schema/layer.v0.1.schema.json"
  },
  "files": ["src", "schema", "dist", "bin"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node dist/src/cli.js validate ../../tests/fixtures/good-minimal.wgif",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3"
  }
}
