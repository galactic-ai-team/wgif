{
  "name": "wgif",
  "private": true,
  "version": "0.0.0",
  "description": "WGIF — World Generative Interactive Format: portable, explorable, interactive 3D worlds in a single file.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tools/img2world/tsconfig.json",
    "test": "npm run test --workspaces --if-present && vitest run scripts",
    "build": "npm run build --workspaces --if-present",
    "pack:court": "npm run pack --workspace @wgif/example-court",
    "dev": "npm run dev --workspace @wgif/player",
    "img2world": "tsx tools/img2world/src/cli.ts",
    "img2world:fetch-model": "tsx tools/img2world/src/fetch-model.ts",
    "size:report": "tsx scripts/size-report.ts",
    "render:report": "tsx scripts/render-report.ts",
    "lab:compression": "tsx scripts/asset-compression-lab.ts",
    "gen:validator": "tsx scripts/gen-validator.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "meshoptimizer": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
