{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "packages/**/*.ts",
    "examples/**/*.ts",
    "tools/img2world/**/*.ts",
    "apps/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    ".cache"
  ]
}